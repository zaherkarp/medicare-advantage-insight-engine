# MA Signal Monitor Configuration
# Copy this file to .env and fill in values.

# Webhook endpoint URL
# For ntfy.sh: https://ntfy.sh/your-topic-name (free, no signup)
# For Teams: your Teams incoming webhook URL
# For testing: https://webhook.site/<your-uuid> or similar inspector
WEBHOOK_URL=https://ntfy.sh/ma-signal-monitor

# Webhook mode: "ntfy", "generic", "teams", or "test"
# ntfy = push notifications via ntfy.sh (recommended — free, no signup)
# teams = Microsoft Teams Adaptive Cards
# generic = raw JSON to any endpoint
# test = logs payload without sending
WEBHOOK_MODE=ntfy

# Log level: DEBUG, INFO, WARNING, ERROR
LOG_LEVEL=INFO

# Database path (relative to project root)
DB_PATH=data/state.db

# Config directory (relative to project root)
CONFIG_DIR=config

# Maximum items per source per run (0 = unlimited)
MAX_ITEMS_PER_SOURCE=50

# Minimum relevance score to trigger an alert (0.0 - 1.0)
MIN_RELEVANCE_SCORE=0.3

# Public archive display floor (0.0 - 1.0). Stories scoring below this are
# still stored (for auditability, source-yield review, and the operator's live
# app) but are hidden from the browsable surfaces — the feed, topic/state
# pages, search, and the static Pages site. It filters pure source-priority
# "noise": items that matched no taxonomy keyword and no watched entity, so
# their whole score is just the source-priority floor. Set to 0.0 to disable.
ARCHIVE_MIN_SCORE=0.1

# Request timeout in seconds
REQUEST_TIMEOUT=30

# Concurrent source fetches per run (1 = strictly sequential)
FETCH_WORKERS=8

# User agent for HTTP requests
USER_AGENT=MA-Signal-Monitor/1.0 (Educational/Research)

# --- Web frontend / self-hosting ---

# Run scheduled ingestion inside the web process (set true in Docker)
RUN_SCHEDULER=false

# Hours between scheduled ingestion runs when RUN_SCHEDULER=true
INGEST_INTERVAL_HOURS=6

# Stories per page in the web feed
WEB_PAGE_SIZE=25

# --- Daily Briefing digest ---
# The briefing always renders at /briefing. These settings control the optional
# daily *email* delivery.

# Send the digest email on a daily schedule (requires SMTP_* + DIGEST_TO)
DIGEST_ENABLED=false

# UTC hour to send the daily digest (0-23)
DIGEST_HOUR=13

# Window of stories to include, max items, and minimum score
DIGEST_LOOKBACK_HOURS=24
DIGEST_MAX_ITEMS=12
DIGEST_MIN_SCORE=0.3

# Public base URL for links inside the email (e.g. https://ma.example.com)
PUBLIC_BASE_URL=

# --- Source discovery (opt-in) ---
# Mines outbound links from ingested stories, ranks the domains behind them,
# autodiscovers RSS/Atom feeds on the promising ones, and surfaces candidates
# at /candidates and in the Daily Briefing. See docs/discovery.md.

# Master switch for the whole feature (off by default)
DISCOVERY_ENABLED=false

# Only harvest links from stories scoring at/above this (0.0 - 1.0)
DISCOVERY_MIN_STORY_SCORE=0.3

# Top-N candidate domains to probe for feeds per autodiscovery run
DISCOVERY_MAX_DOMAINS_PER_RUN=20

# Hours between scheduled autodiscovery runs (when RUN_SCHEDULER=true)
DISCOVERY_INTERVAL_HOURS=24

# Don't re-probe the same domain more often than this many days
DISCOVERY_RECHECK_DAYS=14

# Ignore one-off domains seen fewer than this many times
DISCOVERY_MIN_TIMES_SEEN=2

# Hybrid auto-promotion: a discovered feed goes live automatically when its
# domain's accumulated score AND sighting count both clear these thresholds.
DISCOVERY_AUTOPROMOTE_SCORE=3.0
DISCOVERY_AUTOPROMOTE_MIN_SEEN=4

# Prune dormant (unreviewed/rejected) candidates after this many days
CANDIDATE_RETENTION_DAYS=180

# SMTP delivery
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_USE_TLS=true
DIGEST_FROM=
DIGEST_TO=

# --- Crowd feedback (giscus) ---
# When set, static story pages mount a giscus comment/reaction thread keyed on
# the story's stable item_id (mapping: specific). Reactions can be pulled back
# into the feedback table with `ma-signal-feedback ingest-github`. These four
# values are public (giscus exposes them client-side) — get them from
# https://giscus.app after enabling Discussions on your repo.
GISCUS_REPO=            # owner/name, e.g. zaherkarp/medicare-advantage-insight-engine
GISCUS_REPO_ID=
GISCUS_CATEGORY=General
GISCUS_CATEGORY_ID=
GISCUS_THEME=light

# GitHub token used ONLY by `ma-signal-feedback ingest-github` to read reactions
# via the GraphQL API. A fine-grained PAT with read-only Discussions access is
# enough. Keep this secret — unlike the GISCUS_* values above, it is never
# exposed to the browser.
GITHUB_TOKEN=

# --- ntfy feedback buttons (owner channel) ---
# When NTFY_FEEDBACK_TOPIC is set and WEBHOOK_MODE=ntfy, each alert carries
# 👍/👎 buttons that publish a vote to this (separate, private) topic. Pull the
# votes in with `ma-signal-feedback ingest-ntfy`. Use a hard-to-guess topic name
# since anyone who knows it could post votes.
NTFY_SERVER=https://ntfy.sh
NTFY_FEEDBACK_TOPIC=

# --- Source-yield review ---
# The /status page flags sources that under-deliver: at least MIN_SAMPLE stories
# but a relevance yield below YIELD_FLOOR and a best score below MAX_SCORE_FLOOR.
# Flagging is advisory — you confirm the disable in sources.yaml.
SOURCE_REVIEW_MIN_SAMPLE=25
SOURCE_REVIEW_YIELD_FLOOR=0.05
SOURCE_REVIEW_MAX_SCORE_FLOOR=0.2
